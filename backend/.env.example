# Local default. For PostgreSQL use postgresql+psycopg://user:password@host:5432/database
DATABASE_URL=sqlite:///./data/attendance.db
CORS_ORIGINS=http://localhost:5173
DEMO_MODE=true
UPLOAD_MAX_MB=100
MAX_VIDEO_DURATION_SECONDS=1800
MAX_VIDEO_FRAMES=60000
MEDIAPIPE_MODEL_PATH=
ROSTER_IMPORT_TOKEN=
# Generate locally with Python secrets; keep this value private and remove/rotate after setup.
AUTH_BOOTSTRAP_TOKEN=
# Future UTC ISO-8601 expiry, e.g. 2026-10-30T12:00:00Z. Required for one-time setup.
AUTH_BOOTSTRAP_TOKEN_EXPIRES_AT=
